# ============================================================
# 1. 敏感信息：绝对不要提交到 GitHub
# ============================================================
# 真实密钥放 .env；.env.example 是模板，需要提交
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.p12
*.pfx
secrets.*
credentials.*

# ============================================================
# 2. Python 虚拟环境（任意名称）
# ============================================================
.venv*/
venv*/
env/
ENV/
env.bak/
venv.bak/
pyvenv.cfg

# ============================================================
# 3. Python 缓存 / 构建 / 测试产物
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# ============================================================
# 4. 运行期数据（含客户工单、会话日志、下载的模型）
# ============================================================
*.db
*.sqlite
*.sqlite3
*.log
*.jsonl
.sessions/
data/sessions/
data/agent_workspace/
data/models/

# ============================================================
# 5. 大体积镜像 / 压缩包（可能内含源码和凭据）
# ============================================================
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
my-smart-agent.tar

# ============================================================
# 6. 编辑器与操作系统临时文件
# ============================================================
.idea/
.vscode/
.DS_Store
Thumbs.db
*.lnk

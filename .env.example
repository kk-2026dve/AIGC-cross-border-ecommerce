# ============================================================
# 环境变量模板
#   用法：cp .env.example .env  然后填入真实值
#   .env 已被 .gitignore 忽略，请勿把真实密钥写进本文件或提交到仓库
#   代码中通过 os.getenv("...") / config.py 读取，禁止硬编码
# ============================================================

# ---------- 必填：大模型 API 凭据 ----------
# DeepSeek：在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 如接入其它厂商，同样只在这里配置，并在代码中用 os.getenv 读取：
# ZHIPU_API_KEY=your-zhipu-api-key-here
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 可选：模型与端点 ----------
# 留空 = 使用官方公开端点 https://api.deepseek.com；OpenAI 兼容代理可覆盖
DEEPSEEK_BASE_URL=
DSH_MODEL=deepseek-chat
DSH_MAX_TOKENS=8192
DSH_CONTEXT_WINDOW=64000

# ---------- 可选：DeepSeek Harness 运行时（agent/cordis.yml） ----------
# DSH_SYSTEM_PROMPT=
# DSH_CWD=
# DSH_SESSION_ROOT=./data/sessions

# ---------- 可选：Web 服务 ----------
APP_HOST=127.0.0.1
APP_PORT=8000

# ---------- 可选：业务阈值 ----------
KB_TOP_K=3
ESCALATE_SCORE=8

# ---------- 可选：本地模型目录（rembg / test_api.py） ----------
# U2NET_HOME=./data/models
